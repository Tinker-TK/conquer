# 雪天外观资源；关卡共享预设只读，SnowWeather 在运行时复制。
@tool
extends Resource
class_name SnowWeatherSettings

@export_category("雪天开关")
## 雪天效果总开关。关闭时隐藏雪花、地面积雪和物体覆雪，并暂停自动堆积与融化；开启雪天会自动关闭雨天效果。
@export var enabled := true
## 降雪强度，范围 0～1；越大则同时飘落的雪花越多，场景雪天色调越明显。[br]
## 设为 0 停止飘雪，但已有积雪仍保留；开启自动堆积时会开始融化。
@export_range(0.0, 1.0, 0.01) var intensity := 0.65
## 雪天的整体场景色调，与原始颜色混合。混合强度取降雪强度和当前积雪覆盖度一半中的较大值；白色保持原始色调。
@export var atmosphere_tint := Color(0.84, 0.9, 1.0)
## 地面雪斑与物体覆雪噪声的随机种子。相同种子和参数生成相同的雪斑分布；修改可更换分布，不控制飘落雪花的随机位置。
@export var random_seed := 1907

@export_category("飘落雪花")
## 满强度降雪时的雪花粒子数量，约 70% 用于远景、30% 用于近景；实际数量还受降雪强度影响。越大则雪花越密集，渲染开销也越高。
@export_range(16, 1600, 1) var snow_amount := 700
## 雪花向下飘落的基础速度，单位为世界像素/秒；越大则落得越快。远景雪花速度约为近景的 65%，每片雪花还会有随机速度差异。
@export_range(10.0, 400.0, 1.0) var fall_speed := 70.0
## 雪花的水平飘移速度，单位为世界像素/秒；负值向左，正值向右，0 表示无整体横向风。绝对值越大则斜向飘落越明显。
@export_range(-300.0, 300.0, 1.0) var wind := -22.0
## 每片 3×3 像素雪花的放大倍数；越大则雪花越大。远景雪花略小，实际绘制大小不随镜头缩放改变。
@export_range(0.5, 4.0, 0.1) var flake_scale := 2.4
## 飘落雪花的不透明度，范围 0～1；0 完全透明，1 最清晰。只影响空中的雪花，远景雪花会额外变淡。
@export_range(0.0, 1.0, 0.01) var snow_opacity := 1.0
## 飘落雪花的颜色；颜色的 Alpha 会与雪花不透明度相乘。地面和物体上的积雪颜色由 Snow Tint 与 Snow Shadow 控制。
@export var snow_color := Color(0.95, 0.98, 1.0)

@export_category("地面积雪与融化")
## 是否显示地面积雪。关闭后仍可飘雪和显示物体覆雪，积雪覆盖度也仍会按自动堆积设置更新。
@export var ground_snow_enabled := true
## 应用配置时的初始积雪覆盖度，范围 0～1；0 无积雪，1 覆盖全部可积雪地面，越大则雪斑越多。也会影响物体覆雪；开启自动堆积后会继续变化。
@export_range(0.0, 1.0, 0.01) var initial_coverage := 0.68
## 是否随时间自动改变积雪覆盖度。有降雪时按堆积速度增长，降雪强度为 0 时按融化速度减少；关闭后保持当前覆盖度。
@export var automatic_accumulation := true
## 自动堆积开启且降雪强度大于 0 时，每秒覆盖度增加此值乘以降雪强度。越大则积雪形成越快；例如 0.012 在满强度时每秒增加 0.012 覆盖度。
@export_range(0.0, 0.2, 0.001) var accumulation_rate := 0.012
## 自动堆积开启且降雪强度为 0 时，每秒减少的积雪覆盖度。越大则融化越快，0 表示不融化；关闭雪天总开关时不会继续融化。
@export_range(0.0, 0.2, 0.001) var melt_rate := 0.035
## 积雪噪声斑块的尺度；越大则地面雪斑越宽、越连片，越小则雪斑越细碎。也会影响物体覆雪使用的噪声纹理。
@export_range(24.0, 512.0, 1.0) var patch_scale := 140.0
## 地面雪斑采样网格的大小，单位为世界像素；越大则积雪边缘越粗、像素块越明显，越小则更细腻。不会改变空中雪花的大小。
@export_range(1.0, 8.0, 1.0) var pixel_size := 3.0
## 地面积雪和物体覆雪的主要亮部颜色。颜色的 Alpha 控制地面积雪的不透明度；物体覆雪只使用此颜色的 RGB。
@export var snow_tint := Color(0.86, 0.93, 1.0)
## 地面积雪和物体覆雪的暗部颜色，用于雪斑边缘、颗粒和物体阴影处；与 Snow Tint 搭配控制积雪的明暗层次。只使用颜色的 RGB。
@export var snow_shadow := Color(0.55, 0.69, 0.82)
## 地面积雪保留原地面明暗纹理的程度，范围 0～1；0 使用积雪自身颜色，越大则原地面明暗对积雪颜色的影响越明显。
@export_range(0.0, 1.0, 0.01) var ground_detail := 0.3

@export_category("树木与静态物体覆雪")
## 是否给树木等场景精灵添加覆雪层。只处理符合条件的场景物体，战斗单位、地形瓦片和标记为排除覆雪的物体不会参与。
@export var scenery_snow_enabled := true
## 物体覆雪强度系数，范围 0～1；与当前积雪覆盖度相乘。越大则物体上覆雪越多，0 表示无覆雪；只有开启物体覆雪时可见。
@export_range(0.0, 1.0, 0.01) var scenery_coverage := 0.85
## 物体覆雪的下边界，按图片从顶部 0 到底部 1 的相对高度计算。越大则覆雪能延伸得越靠下，边界附近会渐隐；较小值可保留更多树干和物体下部。
@export_range(0.0, 1.0, 0.01) var scenery_snowline := 0.8
## 同时添加覆雪层的场景精灵数量上限。越大则可覆雪的物体越多，但渲染与更新开销也越高；超过上限的物体保持原样。
@export_range(8, 256, 1) var max_scenery := 128
