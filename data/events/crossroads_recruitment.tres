tags = Array[String]([])
requires = Array[String]([])
choices = Array[Dictionary]([{"text": "挑选一名新兵", "effect": {"type": "choose_cards", "unit_offer": 3, "unit_picks": 1, "effect_offer": 0, "effect_picks": 0}, "result_text": "新兵背起行囊，在你的旗帜下站定。", "heal": 0, "gold": 0}, {"text": "抄录一份战术", "effect": {"type": "choose_cards", "unit_offer": 0, "unit_picks": 0, "effect_offer": 3, "effect_picks": 1}, "result_text": "你记下最后一行，收好这份行军的底气。", "heal": 0, "gold": 0}, {"text": "只要一碗水", "heal": 12, "result_text": "清水洗去尘土。队伍稍作休整，继续向前。", "gold": 0}, {"text": "离开", "leave": true, "heal": 0, "gold": 0}])
