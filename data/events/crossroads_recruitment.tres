[resource]
script = ExtResource("1")
id = "crossroads_recruitment"
title = "岔路的援军"
description = "一队远行的士兵在旧营地歇脚，桌上摊着战术卷轴。\n\n队长把名册推到你面前：兵员和卷轴，只能带走一份。"
template = 4
min_floor = 1
max_floor = 9
rarity = "common"
