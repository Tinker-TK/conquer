[resource]
script = ExtResource("1")
id = "act1_undead_whisper"
title = "亡灵低语"
description = "雾里传来整齐的行军声，却看不见人。一个空洞的声音问你：要不要借走一支不会疲倦的军队？\n\n雾散开一条缝，里面站着几排轮廓模糊的士兵，甲胄上长满了青苔。"
template = 4
min_floor = 6
max_floor = 9
rarity = "rare"
illustration = ExtResource("2")
tags = Array[String](["recruit"])
requires = Array[String]([])
choices = Array[Dictionary]([{"gold": 0, "heal": 0, "effect": {"type": "choose_cards", "unit_offer": 3, "unit_picks": 1, "effect_offer": 0, "effect_picks": 0, "unit_pool": ["res://data/event_recruits/skeleton.tres", "res://data/event_recruits/skeleton_archer.tres", "res://data/event_recruits/greatsword_skeleton.tres"]}, "cost": {"max_hp": 8}, "text": "聆听低语", "summary": "最大生命 -8 · 从 3 张亡灵征召牌中选 1 张", "result_text": "一支骷髅小队从雾里走出来，在你身后排好。它们的脚步声很轻，像有人在很远的地方敲骨头。"}, {"gold": 0, "heal": 20, "cost": {"gold": 25}, "text": "焚烧遗骨", "summary": "支付 25 金币 · 回复 20 生命", "result_text": "火光照亮了雾里的轮廓。行军声停了，你身上的旧伤也轻了。"}, {"gold": 0, "heal": 0, "effect": {"type": "max_hp", "amount": 3}, "cost": {"gold": 20}, "text": "掩埋遗骨", "summary": "支付 20 金币 · 最大生命 +3", "result_text": "你挖了一个浅坑，把散落的骨头埋好，又用二十枚铜币换了一口薄棺。墓碑立起来时，雾散了一点。"}, {"text": "离开", "leave": true, "heal": 0, "gold": 0}])
