tags = Array[String]([])
requires = Array[String]([])
choices = Array[Dictionary]([{"text": "收下药水", "effect": {"type": "random_potion"}, "heal": 0, "gold": 0}, {"text": "帮他试药", "cost": {"hp": 6}, "gold": 40, "effect": {"type": "random_potion"}, "result_text": "药汁苦得舌根发麻。炼金师认真记下你的表情，付清报酬。", "heal": 0}, {"text": "只问路", "heal": 10, "gold": 0}, {"text": "离开", "leave": true, "heal": 0, "gold": 0}])
