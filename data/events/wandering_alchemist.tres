[resource]
script = ExtResource("1")
id = "wandering_alchemist"
title = "旅人的药剂"
description = "林间的炼金师背着药箱，玻璃瓶在斗篷下碰响。\n\n他递来一瓶药，又晃了晃另一只颜色不太对的瓶子，问你愿不愿意替他试试。"
