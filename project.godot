; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ballsprite"
run/main_scene="res://scenes/ui/main_ui.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://autoload/signal_bus.gd"
Global="*res://autoload/global.gd"
McpInteractionServer="*res://autoload/mcp_interaction_server.gd"
RunManager="*res://autoload/run_manager.gd"
GameSettings="*res://autoload/game_settings.gd"
GameAudio="*res://autoload/game_audio.gd"
SceneTransition="*res://autoload/scene_transition.gd"
UIAudio="*res://autoload/ui_audio.gd"
CombatAudio="*res://autoload/combat_audio.gd"
BattleSpeed="*res://autoload/battle_speed.gd"
GamePointer="*res://autoload/game_pointer.gd"
RuntimeGuard="*res://autoload/runtime_guard.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/batch_effect_importer/plugin.cfg", "res://addons/event_editor/plugin.cfg", "res://addons/game_config_editor/plugin.cfg", "res://addons/map_editor/plugin.cfg", "res://addons/wave_editor/plugin.cfg", "res://addons/package_tool/plugin.cfg", "res://addons/level_ui_preview/plugin.cfg")

[gui]

theme/custom_font="uid://41relkj5p65g"

