[node name="blade_clash" type="Node" parent="Samples"]
metadata/title = "攻击 · 刀剑碰撞"
metadata/description = "真实刀剑、斧刃碰撞"

[node name="Sample002" type="AudioStreamPlayer" parent="Samples/blade_clash"]
stream = ExtResource("2")
volume_db = -8.0
metadata/title = "北欧剑与武士刀碰撞 01"
metadata/notes = "真实武器录音，已裁切为单次动作。"
metadata/author = "Ben Jaszczak & Brian Nelson / Still North Media"
metadata/source = "https://opengameart.org/content/medieval-sound-effects-weapon-impacts"
metadata/license = "CC0-1.0"
metadata/changes = "裁切单次动作（如适用）；保留原声道；重采样至44.1kHz；峰值调整；3ms淡入淡出；转OGG。"
